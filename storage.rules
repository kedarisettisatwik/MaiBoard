rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/projects/{projectId}/images/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }
    match /users/{uid}/projects/{projectId}/csv/{fileName} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      allow read, delete: if owner();
      allow create, update: if owner() && fileName.matches('.*[.]csv')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'text/csv';
    }
  }
}
